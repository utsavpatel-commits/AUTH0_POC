# Auth0 / Okta CIC — Application credentials (Regular Web App)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-app-client-id
AUTH0_CLIENT_SECRET=your-app-client-secret

# API Audience — must match the Auth0 API identifier you create
AUTH0_AUDIENCE=platform-api

# Auth0 Management API credentials (Machine-to-Machine app)
AUTH0_MGMT_CLIENT_ID=your-mgmt-client-id
AUTH0_MGMT_CLIENT_SECRET=your-mgmt-client-secret

    # Platform application — must match the URL you use in the browser (ngrok or localhost)
    APP_BASE_URL=http://localhost:8000

# Where invited admins land after password setup (default: confirmation page, not /login)
POST_PASSWORD_REDIRECT_URL=http://localhost:5180/invite/complete

# Session signing — must be >= 32 random chars in production
SECRET_KEY=change-me-32-chars-minimum-REPLACE

# Shared secret used to verify Auth0 Action webhook payloads (HMAC-SHA256)
WEBHOOK_SECRET=change-me-webhook-secret-REPLACE

# SQLite for local POC; swap for postgresql://... in production
DATABASE_URL=sqlite:///./poc.db

# Passwordless — auth0 = Auth0 OTP + Auth0 JWT (default) | local = dev fallback only
PASSWORDLESS_MODE=auth0

# Learner passwordless app (separate from org-required platform-web-app)
# AUTH0_PASSWORDLESS_CLIENT_ID=
# AUTH0_PASSWORDLESS_CLIENT_SECRET=

# Amazon SES (optional — used for local passwordless POC when Auth0 email is unavailable)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=noreply@yourdomain.com
