# Copy to .env to enable live LLM. Leave unset to use deterministic stub responses.
LLM_PROVIDER=stub          # anthropic | openai | stub

# Auth0 passwordless OTP — also copy to backend/.env when running the API locally
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_PASSWORDLESS_CLIENT_ID=
AUTH0_PASSWORDLESS_CLIENT_SECRET=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
PASSWORDLESS_MODE=auth0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Contentful CMS/DMS showcase automation. CONTENTFUL_ENVIRONMENT defaults to master.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_MANAGEMENT_TOKEN=

# Where invited admins land after setting their password (not /login).
POST_PASSWORD_REDIRECT_URL=http://localhost:5180/invite/complete

# Frontend Contentful delivery variables. Also place these in frontend/.env.local for Vite.
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ENVIRONMENT=master
VITE_CONTENTFUL_DELIVERY_TOKEN=
